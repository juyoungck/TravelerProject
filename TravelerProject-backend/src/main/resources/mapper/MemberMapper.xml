<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
    MemberMapper.xml
    회원 관련 SQL 매퍼
    
    소셜 로그인 지원:
    - m_login_type: LOCAL, KAKAO, NAVER, GOOGLE
    - m_username: 소셜 로그인 시 "KAKAO_123456" 형태
-->
<mapper namespace="com.traveler.app.dao.MemberDao">

    <!-- 결과 매핑 (m_login_type 추가) -->
    <resultMap id="MemberResultMap" type="com.traveler.app.entity.Member">
        <id property="mId" column="m_id"/>
        <result property="mUsername" column="m_username"/>
        <result property="mPasswd" column="m_passwd"/>
        <result property="mLoginType" column="m_login_type"/>
        <result property="mNickname" column="m_nickname"/>
        <result property="mEmail" column="m_email"/>
        <result property="mPhone" column="m_phone"/>
        <result property="mGender" column="m_gender"/>
        <result property="mBirth" column="m_birth"/>
        <result property="mRole" column="m_role"/>
        <result property="mStatus" column="m_status"/>
        <result property="mRegdate" column="m_regdate"/>
        <result property="mPasswdDate" column="m_passwd_date"/>
        <result property="mDeldate" column="m_deldate"/>
    </resultMap>

    <!-- 회원 등록 (m_login_type 추가) -->
    <insert id="insertMember" parameterType="com.traveler.app.entity.Member">
        <selectKey keyProperty="mId" resultType="long" order="BEFORE">
            SELECT seq_member.NEXTVAL FROM DUAL
        </selectKey>
        INSERT INTO member (
            m_id, m_username, m_passwd, m_login_type, m_nickname, m_email, 
            m_phone, m_gender, m_birth, m_role, m_status, 
            m_regdate, m_passwd_date
        ) VALUES (
            #{mId}, 
            #{mUsername}, 
            #{mPasswd}, 
            #{mLoginType, jdbcType=VARCHAR},
            #{mNickname}, 
            #{mEmail},
            #{mPhone, jdbcType=VARCHAR}, 
            #{mGender, jdbcType=VARCHAR}, 
            #{mBirth, jdbcType=DATE}, 
            #{mRole, jdbcType=VARCHAR}, 
            #{mStatus, jdbcType=VARCHAR},
            SYSDATE, 
            SYSDATE
        )
    </insert>

    <!-- 회원 ID로 조회 -->
    <select id="selectMemberById" parameterType="long" resultMap="MemberResultMap">
        SELECT * FROM member WHERE m_id = #{mId}
    </select>

    <!-- 아이디로 조회 (소셜 로그인: KAKAO_123456 형태) -->
    <select id="selectMemberByUsername" parameterType="string" resultMap="MemberResultMap">
        SELECT * FROM member WHERE m_username = #{username}
    </select>

    <!-- 이메일로 조회 -->
    <select id="selectMemberByEmail" parameterType="string" resultMap="MemberResultMap">
        SELECT * FROM member WHERE m_email = #{email}
    </select>

    <!-- 닉네임으로 조회 -->
    <select id="selectMemberByNickname" parameterType="string" resultMap="MemberResultMap">
        SELECT * FROM member WHERE m_nickname = #{nickname}
    </select>

    <!-- 아이디 중복 체크 -->
    <select id="countByUsername" parameterType="string" resultType="int">
        SELECT COUNT(*) FROM member WHERE m_username = #{username}
    </select>

    <!-- 이메일 중복 체크 -->
    <select id="countByEmail" parameterType="string" resultType="int">
        SELECT COUNT(*) FROM member WHERE m_email = #{email}
    </select>

    <!-- 닉네임 중복 체크 -->
    <select id="countByNickname" parameterType="string" resultType="int">
        SELECT COUNT(*) FROM member WHERE m_nickname = #{nickname}
    </select>

    <!-- 회원 정보 수정 -->
    <update id="updateMember" parameterType="com.traveler.app.entity.Member">
        UPDATE member SET
            m_nickname = #{mNickname},
            m_phone = #{mPhone, jdbcType=VARCHAR},
            m_gender = #{mGender, jdbcType=VARCHAR},
            m_birth = #{mBirth, jdbcType=DATE}
        WHERE m_id = #{mId}
    </update>

    <!-- 비밀번호 수정 -->
    <update id="updatePassword">
        UPDATE member SET
            m_passwd = #{newPassword},
            m_passwd_date = SYSDATE
        WHERE m_id = #{mId}
    </update>

    <!-- 회원 상태 변경 -->
    <update id="updateMemberStatus">
        UPDATE member SET
            m_status = #{status},
            m_deldate = CASE WHEN #{status} = 'DELETED' THEN SYSDATE ELSE NULL END
        WHERE m_id = #{mId}
    </update>

    <!-- 아이디 찾기용 조회 (일반 회원만) -->
    <select id="selectMemberForFindId" parameterType="string" resultMap="MemberResultMap">
        SELECT * FROM member 
        WHERE m_email = #{email} 
        AND m_status = 'ACTIVE'
        AND (m_login_type = 'LOCAL' OR m_login_type IS NULL)
    </select>

    <!-- 비밀번호 찾기용 조회 (일반 회원만) -->
    <select id="selectMemberForFindPassword" resultMap="MemberResultMap">
        SELECT * FROM member 
        WHERE m_username = #{username} 
        AND m_email = #{email} 
        AND m_status = 'ACTIVE'
        AND (m_login_type = 'LOCAL' OR m_login_type IS NULL)
    </select>

    <!-- 회원 로그인 타입 변경 (소셜 연동 시 LOCAL → BOTH) -->
    <update id="updateMemberLoginType">
        UPDATE member SET
            m_login_type = #{loginType}
        WHERE m_id = #{mId}
    </update>

    <!-- ============================================ -->
    <!-- 회원 탈퇴 (Hard Delete) 관련 쿼리 -->
    <!-- ============================================ -->

    <!-- 회원 삭제 -->
    <delete id="deleteMember">
        DELETE FROM member WHERE m_id = #{mId}
    </delete>

    <!-- 회원의 리뷰 삭제 -->
    <delete id="deleteReviewsByMemberId">
        DELETE FROM review WHERE m_id = #{mId}
    </delete>

    <!-- 회원의 여행지 찜 삭제 -->
    <delete id="deleteFavoriteDestinationsByMemberId">
        DELETE FROM favorite_destination WHERE m_id = #{mId}
    </delete>

    <!-- 회원의 플래너 찜 삭제 -->
    <delete id="deleteFavoritePlannersByMemberId">
        DELETE FROM favorite_planner WHERE m_id = #{mId}
    </delete>

    <!-- 회원의 댓글 삭제 -->
    <delete id="deleteCommentsByMemberId">
        DELETE FROM board_comment WHERE m_id = #{mId}
    </delete>

    <!-- 회원의 게시글 삭제 -->
    <delete id="deleteBoardsByMemberId">
        DELETE FROM board WHERE m_id = #{mId}
    </delete>

    <!-- 회원의 플래너 삭제 (ON DELETE CASCADE로 day, place 자동 삭제) -->
    <delete id="deletePlannersByMemberId">
        DELETE FROM planner WHERE m_id = #{mId}
    </delete>

    <!-- 회원의 소셜 계정 삭제 -->
    <delete id="deleteSocialAccountsByMemberId">
        DELETE FROM social_account WHERE m_id = #{mId}
    </delete>

    <!-- 회원의 리프레시 토큰 삭제 -->
    <delete id="deleteRefreshTokensByMemberId">
        DELETE FROM refresh_token WHERE m_id = #{mId}
    </delete>

</mapper>
