<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
    FavoriteMapper.xml
    찜(즐겨찾기) 관련 SQL 매퍼
    
    @author TravelerProject
-->
<mapper namespace="com.traveler.app.dao.FavoriteDao">

    <!-- ============================================ -->
    <!-- 여행지 찜 -->
    <!-- ============================================ -->
    
    <!-- 여행지 찜 결과 매핑 -->
    <resultMap id="FavoriteDestinationResultMap" type="com.traveler.app.entity.FavoriteDestination">
        <id property="favId" column="fav_id"/>
        <result property="mId" column="m_id"/>
        <result property="contentid" column="contentid"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>
    
    <!-- 내 여행지 찜 DTO 결과 매핑 (여행지 정보 포함) -->
    <resultMap id="MyFavoriteDestinationDtoResultMap" type="com.traveler.app.dto.MyFavoriteDestinationDto">
        <id property="favId" column="fav_id"/>
        <result property="mId" column="m_id"/>
        <result property="contentid" column="contentid"/>
        <result property="createdAt" column="created_at"/>
        <!-- 여행지 정보 -->
        <result property="title" column="title"/>
        <result property="firstimage" column="firstimage"/>
        <result property="addr1" column="addr1"/>
        <result property="contenttypeid" column="contenttypeid"/>
        <result property="lDongRegnCd" column="lDongRegnCd"/>
        <result property="lDongSignguCd" column="lDongSignguCd"/>
    </resultMap>
    
    <!-- 내 여행지 찜 목록 조회 (여행지 정보 포함) -->
    <select id="selectMyFavoriteDestinations" parameterType="long" resultMap="MyFavoriteDestinationDtoResultMap">
        SELECT 
            f.fav_id,
            f.m_id,
            f.contentid,
            f.created_at,
            d.title,
            d.firstimage,
            d.addr1,
            d.contenttypeid,
            d.lDongRegnCd,
            d.lDongSignguCd
        FROM favorite_destination f
        LEFT JOIN destination d ON f.contentid = d.contentid
        WHERE f.m_id = #{mId}
        ORDER BY f.created_at DESC
    </select>
    
    <!-- 여행지 찜 추가 -->
    <insert id="insertFavoriteDestination" parameterType="com.traveler.app.entity.FavoriteDestination">
        <selectKey keyProperty="favId" resultType="long" order="BEFORE">
            SELECT seq_favorite_destination.NEXTVAL FROM DUAL
        </selectKey>
        INSERT INTO favorite_destination (
            fav_id, m_id, contentid, created_at
        ) VALUES (
            #{favId}, #{mId}, #{contentid}, SYSDATE
        )
    </insert>
    
    <!-- 여행지 찜 삭제 -->
    <delete id="deleteFavoriteDestination">
        DELETE FROM favorite_destination 
        WHERE m_id = #{mId} AND contentid = #{contentid}
    </delete>
    
    <!-- 여행지 찜 여부 확인 -->
    <select id="checkFavoriteDestination" resultType="int">
        SELECT COUNT(*) FROM favorite_destination 
        WHERE m_id = #{mId} AND contentid = #{contentid}
    </select>
    
    <!-- 내 여행지 찜 개수 조회 -->
    <select id="countMyFavoriteDestinations" parameterType="long" resultType="int">
        SELECT COUNT(*) FROM favorite_destination WHERE m_id = #{mId}
    </select>
    
    <!-- ============================================ -->
    <!-- 플래너 찜 -->
    <!-- ============================================ -->
    
    <!-- 플래너 찜 결과 매핑 -->
    <resultMap id="FavoritePlannerResultMap" type="com.traveler.app.entity.FavoritePlanner">
        <id property="favId" column="fav_id"/>
        <result property="mId" column="m_id"/>
        <result property="plnId" column="pln_id"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>
    
    <!-- 내 플래너 찜 DTO 결과 매핑 (플래너 정보 포함) -->
    <resultMap id="MyFavoritePlannerDtoResultMap" type="com.traveler.app.dto.MyFavoritePlannerDto">
        <id property="favId" column="fav_id"/>
        <result property="mId" column="m_id"/>
        <result property="plnId" column="pln_id"/>
        <result property="createdAt" column="created_at"/>
        <!-- 플래너 정보 -->
        <result property="plnTitle" column="pln_title"/>
        <result property="plnMId" column="pln_m_id"/>
        <result property="authorNickname" column="author_nickname"/>
        <result property="startDate" column="start_date"/>
        <result property="endDate" column="end_date"/>
        <result property="totalDays" column="total_days"/>
        <result property="lDongRegnCd" column="lDongRegnCd"/>
        <result property="lDongSignguCd" column="lDongSignguCd"/>
        <result property="isPublic" column="is_public"/>
    </resultMap>
    
    <!-- 내 플래너 찜 목록 조회 (플래너 정보 포함) -->
    <select id="selectMyFavoritePlanners" parameterType="long" resultMap="MyFavoritePlannerDtoResultMap">
        SELECT 
            f.fav_id,
            f.m_id,
            f.pln_id,
            f.created_at,
            p.pln_title,
            p.m_id AS pln_m_id,
            m.m_nickname AS author_nickname,
            p.start_date,
            p.end_date,
            p.total_days,
            p.lDongRegnCd,
            p.lDongSignguCd,
            p.is_public
        FROM favorite_planner f
        LEFT JOIN planner p ON f.pln_id = p.pln_id
        LEFT JOIN member m ON p.m_id = m.m_id
        WHERE f.m_id = #{mId}
        ORDER BY f.created_at DESC
    </select>
    
    <!-- 플래너 찜 추가 -->
    <insert id="insertFavoritePlanner" parameterType="com.traveler.app.entity.FavoritePlanner">
        <selectKey keyProperty="favId" resultType="long" order="BEFORE">
            SELECT seq_favorite_planner.NEXTVAL FROM DUAL
        </selectKey>
        INSERT INTO favorite_planner (
            fav_id, m_id, pln_id, created_at
        ) VALUES (
            #{favId}, #{mId}, #{plnId}, SYSDATE
        )
    </insert>
    
    <!-- 플래너 찜 삭제 -->
    <delete id="deleteFavoritePlanner">
        DELETE FROM favorite_planner 
        WHERE m_id = #{mId} AND pln_id = #{plnId}
    </delete>
    
    <!-- 플래너 찜 여부 확인 -->
    <select id="checkFavoritePlanner" resultType="int">
        SELECT COUNT(*) FROM favorite_planner 
        WHERE m_id = #{mId} AND pln_id = #{plnId}
    </select>
    
    <!-- 내 플래너 찜 개수 조회 -->
    <select id="countMyFavoritePlanners" parameterType="long" resultType="int">
        SELECT COUNT(*) FROM favorite_planner WHERE m_id = #{mId}
    </select>

</mapper>
