<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
    ReviewMapper.xml
    리뷰 관련 SQL 매퍼
    
    @author TravelerProject
-->
<mapper namespace="com.traveler.app.dao.ReviewDao">

    <!-- 리뷰 결과 매핑 -->
    <resultMap id="ReviewResultMap" type="com.traveler.app.entity.Review">
        <id property="rvId" column="rv_id"/>
        <result property="mId" column="m_id"/>
        <result property="contentid" column="contentid"/>
        <result property="rvContent" column="rv_content"/>
        <result property="rvRating" column="rv_rating"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>
    
    <!-- 내 리뷰 DTO 결과 매핑 (여행지 정보 포함) -->
    <resultMap id="MyReviewDtoResultMap" type="com.traveler.app.dto.MyReviewDto">
        <id property="rvId" column="rv_id"/>
        <result property="mId" column="m_id"/>
        <result property="contentid" column="contentid"/>
        <result property="rvContent" column="rv_content"/>
        <result property="rvRating" column="rv_rating"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <!-- 여행지 정보 -->
        <result property="title" column="title"/>
        <result property="firstimage" column="firstimage"/>
        <result property="addr1" column="addr1"/>
        <result property="contenttypeid" column="contenttypeid"/>
    </resultMap>

    <!-- 내 리뷰 목록 조회 (여행지 정보 포함) -->
    <select id="selectMyReviews" parameterType="long" resultMap="MyReviewDtoResultMap">
        SELECT 
            r.rv_id,
            r.m_id,
            r.contentid,
            r.rv_content,
            r.rv_rating,
            r.created_at,
            r.updated_at,
            d.title,
            d.firstimage,
            d.addr1,
            d.contenttypeid
        FROM review r
        LEFT JOIN destination d ON r.contentid = d.contentid
        WHERE r.m_id = #{mId}
        ORDER BY r.created_at DESC
    </select>
    
    <!-- 리뷰 상세 조회 -->
    <select id="selectReviewById" parameterType="long" resultMap="ReviewResultMap">
        SELECT * FROM review WHERE rv_id = #{rvId}
    </select>
    
    <!-- 리뷰 등록 -->
    <insert id="insertReview" parameterType="com.traveler.app.entity.Review">
        <selectKey keyProperty="rvId" resultType="long" order="BEFORE">
            SELECT seq_review.NEXTVAL FROM DUAL
        </selectKey>
        INSERT INTO review (
            rv_id, m_id, contentid, rv_content, rv_rating, created_at, updated_at
        ) VALUES (
            #{rvId}, #{mId}, #{contentid}, #{rvContent}, #{rvRating}, SYSDATE, SYSDATE
        )
    </insert>
    
    <!-- 리뷰 수정 -->
    <update id="updateReview" parameterType="com.traveler.app.entity.Review">
        UPDATE review SET
            rv_content = #{rvContent},
            rv_rating = #{rvRating},
            updated_at = SYSDATE
        WHERE rv_id = #{rvId}
    </update>
    
    <!-- 리뷰 삭제 -->
    <delete id="deleteReview" parameterType="long">
        DELETE FROM review WHERE rv_id = #{rvId}
    </delete>
    
    <!-- 특정 여행지의 리뷰 목록 조회 -->
    <select id="selectReviewsByContentid" parameterType="string" resultMap="MyReviewDtoResultMap">
        SELECT 
            r.rv_id,
            r.m_id,
            r.contentid,
            r.rv_content,
            r.rv_rating,
            r.created_at,
            r.updated_at,
            d.title,
            d.firstimage,
            d.addr1,
            d.contenttypeid
        FROM review r
        LEFT JOIN destination d ON r.contentid = d.contentid
        WHERE r.contentid = #{contentid}
        ORDER BY r.created_at DESC
    </select>
    
    <!-- 내 리뷰 개수 조회 -->
    <select id="countMyReviews" parameterType="long" resultType="int">
        SELECT COUNT(*) FROM review WHERE m_id = #{mId}
    </select>

</mapper>
